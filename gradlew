##############################################################################
#
#  Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    case "$link" in
        /*) PRG="$link" ;;
        *) PRG=$(dirname "$PRG")/"$link" ;;
    esac
done
APP_HOME=$(cd -P "$(dirname "$PRG")" >/dev/null && pwd -P)

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
JAVACMD=java
if [ -n "$JAVA_HOME" ]; then JAVACMD="$JAVA_HOME/bin/java"; fi
# Keep Gradle downloads, compiler caches and Java temporary files on project volume.
mkdir -p "$APP_HOME/.tmp/runtime" "$APP_HOME/.tmp/gradle-home" "$APP_HOME/.tmp/kotlin-native"
: "${TMPDIR:=$APP_HOME/.tmp/runtime}"
: "${GRADLE_USER_HOME:=$APP_HOME/.tmp/gradle-home}"
: "${KONAN_DATA_DIR:=$APP_HOME/.tmp/kotlin-native}"
: "${ANDROID_USER_HOME:=$APP_HOME/.tmp/android-user}"
export TMPDIR GRADLE_USER_HOME KONAN_DATA_DIR ANDROID_USER_HOME
mkdir -p "$ANDROID_USER_HOME"
exec "$JAVACMD" "-Djava.io.tmpdir=$TMPDIR" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "-Pkotlin.project.persistent.dir=$APP_HOME/.tmp/kotlin" --project-cache-dir "$APP_HOME/.tmp/project-cache" "$@"
